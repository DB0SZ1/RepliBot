{
  "api_key": "YOUR_OPENROUTER_API_KEY",
  "base_url": "https://openrouter.ai/api/v1",
  "models": {
    "primary": "openai/gpt-oss-120b",
    "fast": "google/gemini-2.5-flash-lite-preview-09-2025",
    "reasoning": "qwen/qwen3-next-80b-a3b-instruct",
    "nano": "openai/gpt-5-nano",
    "chimera": "tngtech/tng-r1t-chimera:free",
    "embedding": "qwen/qwen3-embedding-8b"
  },
  "model_rotation": {
    "learning": ["chimera", "fast"],
    "content_generation": ["primary", "reasoning"],
    "decision_making": ["reasoning", "primary"],
    "quick_analysis": ["nano", "fast"]
  },
  "settings": {
    "temperature": 0.85,
    "max_tokens": 500,
    "top_p": 0.95,
    "timeout_seconds": 60
  },
  "rate_limits": {
    "requests_per_minute": 20,
    "tokens_per_minute": 40000,
    "retry_delay_seconds": 5,
    "max_retries": 3
  }
}
